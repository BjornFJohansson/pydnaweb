import streamlit as st

# Define example data
EXAMPLE_TEXT = """This is an example input.
You can modify it or replace it with your own data.
Click the button again to refill it.
"""

# Function to fill text area with example data
def fill_example():
    st.session_state.text_area_content = EXAMPLE_TEXT
    st.session_state.trigger_scroll = True  # Set flag to trigger scrolling

# Function to clear the text area
def clear_text():
    st.session_state.text_area_content = ""
    st.session_state.trigger_scroll = False  # Reset scroll trigger

# Initialize session state variables
if "text_area_content" not in st.session_state:
    st.session_state.text_area_content = ""
if "trigger_scroll" not in st.session_state:
    st.session_state.trigger_scroll = False

st.title("Auto Scroll")

# Buttons to fill or clear the text area
col1, col2 = st.columns(2)
with col1:
    if st.button("Fill with Example Data"):
        fill_example()
with col2:
    if st.button("Clear Text"):
        clear_text()

# Display text area
st.text_area("Enter your text here:", st.session_state.text_area_content, height=200, key="text_area_content")

# Process input and generate results
if st.button("Generate Results"):
    st.session_state.trigger_scroll = True  # Enable scrolling after result generation

    # Example result output

    st.subheader("Generated Results:")
    st.write("✅ Here is your generated result!")
    st.write("📌 This result will be updated when you click 'Generate Results'.")
    st.markdown("<a id='result'></a>", unsafe_allow_html=True)  # Anchor

# Inject JavaScript to scroll to the result section
if st.session_state.trigger_scroll:
    st.markdown(
        """
        <script>
            window.scrollTo(0, 10000);
        </script>
        """,
        unsafe_allow_html=True,
    )
    st.session_state.trigger_scroll = False  # Reset trigger after scrolling
